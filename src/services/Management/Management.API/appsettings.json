{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=DroneVision;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "DroneVision",
    "Audience": "DroneVision.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
